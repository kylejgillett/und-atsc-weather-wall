[Unit]
Description=Weather Wall ASOS and BUFKIT Soundings

[Service]
Type=oneshot
WorkingDirectory=%h/und-atsc-weather-wall
ExecStart=%h/und-atsc-weather-wall/upload/run_job.sh upload_asos.sh upload_soundings_bufkit.sh
StandardOutput=append:%h/weather_wall_logs/asos_bufkit.log
StandardError=append:%h/weather_wall_logs/asos_bufkit.log